# Copy this file to .env and replace placeholder values for your environment.
# Never commit your .env file to version control.

# Django core settings
SECRET_KEY=replace-with-a-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database configuration
# For SQLite local development:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
#
# For MySQL / PostgreSQL:
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: initial owner account created automatically when User table is empty
# Leave blank if creating superuser manually via `python manage.py createsuperuser`
DEFAULT_OWNER_NAME=
DEFAULT_OWNER_EMAIL=
DEFAULT_OWNER_PASSWORD=
DEFAULT_OWNER_PHONE=
